# Copy to `.env` on the production host (next to docker-compose.prod.yml)
# and fill in real values. Never commit the filled-in file — `.env` is
# gitignored. See docs/deploy.md for where each value comes from.

# Neon connection string — use the "asyncpg" / pooled connection string with
# `postgresql+asyncpg://` as the scheme (Neon gives you `postgresql://` by
# default; just swap the scheme). Keep `?sslmode=require` as Neon gives it —
# app/db.py translates it for asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Upstash Redis — use the "ioredis"/standard `redis://` connection string
# from the Upstash console (rediss:// also works if TLS is enabled there).
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# Cloudflare R2 — from the R2 bucket's "Manage API tokens" page.
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# The public URL browsers will actually fetch media from — either R2's
# public bucket dev URL (pub-xxxx.r2.dev) or a custom domain mapped to the
# bucket. Must be reachable from the browser, unlike S3_ENDPOINT_URL above.
S3_PUBLIC_URL=https://media.yourdomain.com
S3_ACCESS_KEY=your-r2-access-key-id
S3_SECRET_KEY=your-r2-secret-access-key
S3_BUCKET=mori-media

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# The Vercel URL(s) the frontend is actually served from. JSON array syntax
# (pydantic-settings parses list-typed env vars as JSON).
CORS_ORIGINS=["https://your-app.vercel.app"]

# Frontend and API are on different domains in this deploy, so cookies need
# SameSite=None — which browsers additionally require Secure for. Both
# must be set together; app/routers/auth.py enforces Secure whenever
# COOKIE_SAMESITE=none regardless of this value, but set it explicitly
# anyway so it's not relying on that fallback.
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# The domain Caddy requests a Let's Encrypt certificate for — must already
# have a DNS A record pointing at this host's public IP before first start.
API_DOMAIN=api.yourdomain.com
